# Site vitrine KinPay Cash — modèle de configuration (aucune valeur secrète ici).
# Copiez ce fichier en .env puis renseignez les valeurs. Le fichier .env n'est jamais committé.

APP_NAME="KinPay Cash"
# « production » sur kinpaycash.com : active l'indexation (sinon noindex partout) et les adresses par défaut de l'application.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Adresse publique du site (sert à l'URL canonique et au sitemap). En production : https://kinpaycash.com
APP_URL=http://localhost

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=kinpay_vitrine
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie de session « Secure » : activé par défaut quand APP_ENV=production.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# --- Liens vers l'application KinPay Cash (autre projet) ---
# En production, sans valeur, ces adresses valent https://cps.kinpaycash.com/login, /inscription et la base des pages légales.
# Hors production, un lien vide est masqué.
# KINPAY_APP_BASE_URL=https://cps.kinpaycash.com
APP_LOGIN_URL=
APP_REGISTER_URL=
LEGAL_BASE_URL=
# true tant que les conditions, la confidentialité et les mentions légales sont provisoires (mention « provisoire »).
LEGAL_PAGES_PROVISIONAL=true

# --- Boutiques d'applications : masquées tant qu'elles sont vides ---
GOOGLE_PLAY_URL=
APP_STORE_URL=

# --- Contacts publics : chacun masqué tant qu'il est vide ---
CONTACT_EMAIL=
# Numéros au format international, chiffres seulement (indicatif 243 compris).
CONTACT_PHONE=
CONTACT_WHATSAPP=
CONTACT_ADDRESS=

# --- Réseaux sociaux : adresse https complète, masqués tant qu'ils sont vides ---
SOCIAL_FACEBOOK_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_LINKEDIN_URL=
SOCIAL_X_URL=
SOCIAL_TIKTOK_URL=

# --- Formulaire de support ---
# Obligatoire : sans destinataire, le formulaire est masqué (la page Aide n'affiche que les contacts renseignés).
SUPPORT_TO_ADDRESS=
# Nombre maximal d'envois par heure et par adresse IP.
SUPPORT_MAX_PER_HOUR=5

# --- Courriel (SMTP) ---
# « log » n'envoie rien : en production, le formulaire est alors masqué. Utilisez « smtp ».
# Exemple Resend : MAIL_HOST=smtp.resend.com, MAIL_PORT=465, MAIL_SCHEME=smtps, MAIL_USERNAME=resend,
# MAIL_PASSWORD=<votre clé API Resend, à saisir seulement dans le .env du serveur>.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Adresse d'expédition d'un domaine vérifié chez votre fournisseur de courriel.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
